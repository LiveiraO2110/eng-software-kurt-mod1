@startuml Deploy_Prospeccao

skinparam backgroundColor white
left to right direction

node "Usuário" as User <<device>>

cloud "Render Cloud" as Render {

    node "Frontend Service" as Frontend <<hosting>> {
        artifact "React SPA"
    }

    node "Backend Service" as Spring <<container>> {
        artifact "Spring Boot REST API"
        artifact "DailySearch Scheduler"
    }
}

cloud "Supabase Cloud" as Supabase {
    database "PostgreSQL" as PostgreSQL
}

cloud "API PNCP" as PNCP <<external>>

User --> Frontend : HTTPS

Frontend <--> Spring : HTTPS/JSON

Spring --> PostgreSQL : JDBC

Spring --> PNCP : REST API

@enduml
