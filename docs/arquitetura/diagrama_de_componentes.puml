@startuml

skinparam componentStyle rectangle
skinparam backgroundColor white


package "Frontend (React)" {

  package "Telas principais" {
    [CadastroCliente] 
    [ListagemPropostas] 
    [PropostasSalvas] 
  }

  package "Componente de suporte" {
    [AlterarFiltrosBusca]
  }
}

package "Backend (Spring Boot)" {

    package "Controllers" {
        [ClientesController]
        [PropostasController]
        [EditalController]
        [AuthController]
    }

    package "Services" {
        [PropostasService]
        [ClientesService]
        [DailySearch]
        [EditalService]
    }

    package "Repositories" {
        [PropostasRepository]
        [ClienteRepository]
        [EditalRepository]
    }
}

database "PostgreSQL" as DB

[APIPNCP] <<external>>

' Frontend → Controllers
CadastroCliente    --> ClientesController   : REST
ListagemPropostas  --> PropostasController  : REST
PropostasSalvas    --> PropostasController  : REST 
ListagemPropostas  --> PropostasController  : REST 
Dashboard          --> PropostasController  : REST
AuthLogin          --> AuthController       : REST
Dashboard          --> EditalController     : REST
AlterarFiltrosBusca       --> ClientesController   : REST


PropostasController --> PropostasService
ClientesController --> ClientesService
EditalController --> EditalService

ClientesService --> ClienteRepository
PropostasService --> PropostasRepository
EditalService --> EditalRepository

DailySearch --> PropostasRepository

PropostasService --> APIPNCP : API REST
DailySearch --> APIPNCP : API REST

PropostasRepository --> DB
ClienteRepository --> DB
EditalRepository --> DB

@enduml
