@startuml

skinparam componentStyle rectangle
skinparam backgroundColor white

@startuml
skinparam componentStyle rectangle
skinparam backgroundColor white

package "Frontend (React)" {

  package "Telas principais" {
    [CadastroCliente] <<screen>>
    note right of [CadastroCliente]
      Formulário com critérios
      de busca no PNCP
      (segmento, valor, UF, palavras-chave)
    end note

    [ListagemPropostas] <<screen>>
    note right of [ListagemPropostas]
      Cards de editais encontrados
      com botão "⭐ Salvar proposta"
      e filtros dinâmicos
    end note

    [PropostasSalvas] <<screen>>
    note right of [PropostasSalvas]
      Favoritos do usuário
      com detalhes e documentos
    end note
  }

  package "Componentes de suporte" {
    [Dashboard]
    [AlertasView]
    [FiltrosBusca]
  }
}

package "Backend (Spring Boot)" {

    package "Controllers" {
        [ClientesController]
        [PropostasController]
        [AuthController]
    }

    package "Services" {
        [PropostasService]
        [ClientesService]
        [DailySearch]
        [DocumentoService]
    }

    package "Repositories" {
        [PropostasRepository]
        [ClienteRepository]
    }
}

database "PostgreSQL" as DB

cloud "Storage PDFs" as Storage

[APIPNCP] <<external>>

Dashboard --> PropostasController : REST
BuscaEdital --> PropostasController : REST
AlertasView --> ClientesController : REST

PropostasController --> PropostasService
ClientesController --> ClientesService

ClientesService --> ClienteRepository
PropostasService --> PropostasRepository

DailySearch --> PropostasRepository

PropostasService --> APIPNCP : API REST
DailySearch --> APIPNCP : API REST

DocumentoService --> Storage
PropostasService --> DocumentoService

PropostasRepository --> DB
ClienteRepository --> DB

@enduml
